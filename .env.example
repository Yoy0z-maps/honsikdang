# Copy to .env.local and fill in. Never commit .env.local.
#
# Local values come from `npm run db:start` (or `npx supabase status`).
# Only client-safe values may use the NEXT_PUBLIC_ prefix.

# Supabase API URL (local default shown)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...). Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NAVER Maps (NCP) Client ID, sent as `ncpKeyId`. Optional; the map shows a
# fallback without it. Register the service URL without a port, e.g.
# http://localhost. The web map does not need the Client Secret: do not add it.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=
