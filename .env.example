# Copy to .env.local and fill in. Never commit .env.local.
#
# Local values come from `npm run db:start` (or `npx supabase status`).
# Only client-safe values may use the NEXT_PUBLIC_ prefix.

# Supabase API URL (local default shown)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase publishable key (sb_publishable_...). Never put a secret key here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NAVER Maps (NCP) Client ID, sent as `ncpKeyId`. Optional; the map shows a
# fallback without it. Register the service URL without a port, e.g.
# http://localhost. The web map does not need the Client Secret: do not add it.
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# AI search (WP-05a). Server-only: never prefix these with NEXT_PUBLIC_.
# OpenAI API key (platform.openai.com). Without it AI search falls back to
# ordinary keyword search. Also set a monthly budget limit in the dashboard.
OPENAI_API_KEY=
# Only when AI_PROVIDER=anthropic.
# ANTHROPIC_API_KEY=
# In-app monthly budget in USD (default 3 ≈ ₩5,000). AI search falls back to
# keyword search once this month's logged cost reaches it.
AI_MONTHLY_BUDGET_USD=3
# "openai" (default) or "anthropic". "fixture" is a test-only stand-in used by
# e2e and is refused unless NEXT_PUBLIC_SUPABASE_URL points at a local
# Supabase.
# AI_PROVIDER=openai

# Semantic ranking (WP-05b). Server-only.
# Voyage AI model API key from MongoDB Atlas (AI Model APIs). Without it AI
# search keeps distance order.
VOYAGE_API_KEY=
# Optional: only for keys scoped to another endpoint.
# VOYAGE_API_BASE=https://ai.mongodb.com/v1
# "voyage" (default). "fixture" is test-only and needs a local Supabase.
# EMBEDDING_PROVIDER=voyage
# Supabase secret key (sb_secret_…) for the embedding job runner only. Local
# value: `npx supabase status -o env` → SECRET_KEY. Never NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Shared secret for POST /api/jobs/embeddings (npm run embed:sync), ≥16 chars.
EMBEDDING_JOB_SECRET=

# Restaurant search in the place suggestion form (WP-08, C-83). Server-only:
# never NEXT_PUBLIC_. NCP console → NAVER API HUB → Application, API "NAVER
# 검색 > 지역" (developers.naver.com search moved there). A separate
# Application from the map key. Without them the search box is
# hidden and users type the details. PLACE_SEARCH_PROVIDER=fixture is
# test-only and needs a local Supabase.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
# PLACE_SEARCH_PROVIDER=naver

# Launch switches and jobs (WP-07).
# AI search is off unless "true" (decision C-76); also needs OPENAI_API_KEY.
NEXT_PUBLIC_AI_SEARCH_ENABLED=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to /api/jobs/daily.
CRON_SECRET=
